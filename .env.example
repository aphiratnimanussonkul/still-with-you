# Supabase Configuration
SUPABASE_URL=https://hazkqphgdkklsvkrhubg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=sb_publishable_TODq1gSkK5bu8InyIJRtVQ_vB7u8zsZ

# Database (local Supabase / app). Tests never use this.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Tests — dedicated database only. Required for `pnpm test`.
# Create once after `pnpm db:start`:
#   psql "$DATABASE_URL" -c "CREATE DATABASE swy_test;"
# then apply migrations to swy_test (see README Testing).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/swy_test

# CORS — comma-separated browser origin allowlist (no "*").
# First origin is used for invite URLs: {WEB_ORIGIN}/invites/{token}
WEB_ORIGIN=http://localhost:5173,https://stillwithyou.nimanussonkul.work,https://still-with-you-5b1.pages.dev

# API Configuration
API_PORT=3000
API_HOST=0.0.0.0

# Storage
STORAGE_BUCKET=private-media
# Service role key for Storage (signed URLs). Name only — never commit a value.
SWY_SUPABASE_SERVICE_ROLE_KEY=
MEDIA_MAX_BYTES=20971520
MEDIA_MAX_PER_CONTRIBUTION=20

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000
# GET /v1/invites/{token} per IP (stricter than RATE_LIMIT_MAX)
INVITE_PREVIEW_RATE_LIMIT_MAX=20

# Docker/Caddy (for production)
DOMAIN=api.example.com
CADDY_EMAIL=admin@example.com

# Google OAuth (for Supabase Auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
